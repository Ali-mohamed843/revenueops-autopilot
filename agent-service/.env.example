# Copy to .env (never commit .env).

# Agent service database. Default matches the postgres service in ../docker-compose.yml
DATABASE_URL=postgresql+psycopg://revenueops:revenueops@localhost:5433/revenueops

# --- The store ---
STORE_ADAPTER=storeforge
STOREFORGE_API_URL=http://localhost:3000/api
# Must equal INTEGRATION_API_KEY in StoreForge's .env
STOREFORGE_API_KEY=

# --- The model: fill in ONE of the two options (same as claude-agent-cli) ---

# Option A: Claude directly (key from https://platform.claude.com)
# ANTHROPIC_API_KEY=sk-ant-...
# AGENT_MODEL=claude-sonnet-5-5

# Option B: OpenRouter (key from https://openrouter.ai/keys)
# OpenRouter speaks the Anthropic Messages API, so the same SDK works with a different base URL.
ANTHROPIC_BASE_URL=https://openrouter.ai/api
ANTHROPIC_AUTH_TOKEN=
AGENT_MODEL=poolside/laguna-s-2.1:free
